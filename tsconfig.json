{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "esnext"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true, "noEmit": true,
    "jsx": "preserve", "incremental": true, "allowJs": true, "isolatedModules": true,
    "plugins": [{ "name": "next" }], "paths": { "@/*": ["./src/*"] }, "types": ["node"]
  },
  "include": ["next-env.d.ts", "src", "scripts", "tests", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
