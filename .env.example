# Copy to .env.local (never commit .env.local). Values come from Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Server-only. Needed for account deletion and the CLI seed script. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Public URL of the site (used in email links). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
